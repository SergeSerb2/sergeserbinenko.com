{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sergeserbinenko-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "sergeserbinenko.com", "custom_domain": true },
    { "pattern": "www.sergeserbinenko.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [{ "name": "GATE", "class_name": "Gate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Gate"] }],
  "ratelimits": [
    { "name": "RL_CHAT", "namespace_id": "1001", "simple": { "limit": 4, "period": 60 } },
    { "name": "RL_SESSION", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  "vars": {
    "MODEL": "gpt-6-luna",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFVT2zlQ6mlsiQO8",
    "DAILY_MESSAGE_CAP": "1500",
    "DAILY_TOKEN_CAP": "4000000",
    "AGENT_ENABLED": "true"
  }
}
