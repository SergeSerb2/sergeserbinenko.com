---
import { scenes, nightScenes, photographerHref, unsplashHref } from "../data/scenes.ts";
import type { SceneId, Scene } from "../data/scenes.ts";

interface Props {
  scenes: SceneId[];
}
const { scenes: pageScenes } = Astro.props;

function chars(place: string): { ch: string; i: number }[] {
  return Array.from(place).map((ch, i) => ({ ch, i }));
}
---
<aside class="places" aria-label="Photo credits">
  {pageScenes.map((id, i) => {
    const dayScene: Scene = scenes[id];
    const nightId = nightScenes[id];
    const nightScene: Scene | undefined = nightId ? scenes[nightId] : undefined;
    const variants: { key: "day" | "night"; scene: Scene }[] = [
      { key: "day", scene: dayScene },
      ...(nightScene ? [{ key: "night" as const, scene: nightScene }] : []),
    ];
    const isFirst = i === 0;
    return (
      <div
        class:list={["place", isFirst && "is-active"]}
        data-stop-index={i}
        inert={!isFirst || undefined}
        style={`--tl: --stop-${i}`}
      >
        {variants.map(({ key, scene }) => {
          const variantActive = isFirst && key === "day";
          return (
            <div class="place__variant" data-variant={key} inert={!variantActive || undefined}>
              <p class="place__coords">{scene.coords}<span class="place__time" data-tz={scene.tz}></span></p>
              <p class="place__name"><span class="sr">{scene.place}</span>{chars(scene.place).map(({ ch, i: ci }) => ch === " " ? <span class="ch ch--space" style={`--i:${ci}`} aria-hidden="true"> </span> : <span class="ch" style={`--i:${ci}`} aria-hidden="true">{ch}</span>)}</p>
              <p class="place__credit">Photo by <a href={photographerHref(scene)} rel="noopener">{scene.photographer}</a> on <a href={unsplashHref} rel="noopener">Unsplash</a></p>
            </div>
          );
        })}
      </div>
    );
  })}
</aside>
