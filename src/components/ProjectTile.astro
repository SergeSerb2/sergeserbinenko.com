---
import type { CollectionEntry } from "astro:content";
import { scenes, photoSrc } from "../data/scenes.ts";
import type { SceneId } from "../data/scenes.ts";

interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const d = project.data;
const slug = project.id;
const scene = scenes[d.scene as SceneId];
const kindLabels: Record<string, string> = {
  product: "Product",
  "open-source": "Open source",
  fork: "Fork",
  work: "Client work",
  experiment: "Experiment",
};
---
<a class="tile glass" href={`/projects/${slug}`} style={`view-transition-name: project-${slug}`}>
  <span class="tile__cover"><img src={photoSrc(scene, 800)} alt="" loading="lazy" decoding="async" style={`--focal: ${scene.focal}`} /><span class="tile__credit">{scene.place} · Photo by {scene.photographer} on Unsplash</span></span>
  <span class="tile__body">
    <span class="eyebrow">{d.year} · {kindLabels[d.kind]}{d.status && <span class="eyebrow__status">{d.status}</span>}</span>
    <span class="tile__title">{d.title}</span>
    <span class="tile__tagline">{d.tagline}</span>
    <span class="chips">{d.stack.map((s) => <span class="chip">{s}</span>)}</span>
  </span>
</a>
