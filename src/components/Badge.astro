---
interface Props {
  text: string;
  class?: string;
  uid?: string;
}
const { text, class: className, uid: uidProp } = Astro.props;
const label = text.toUpperCase();
let repeated = label;
while (repeated.length < 22) repeated += ` · ${label}`;
const ringText = `${repeated} · `;
const uid = (uidProp ?? label).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") || "badge";
---
<span class:list={["badge", className]} aria-hidden="true">
  <svg class="badge__ring" viewBox="0 0 120 120">
    <defs><path id={`badge-${uid}`} d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" /></defs>
    <text><textPath href={`#badge-${uid}`} textLength="289" lengthAdjust="spacing">{ringText}</textPath></text>
  </svg>
  <span class="badge__dot"></span>
</span>
