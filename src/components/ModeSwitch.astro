---
---
<div class="mode glass" role="radiogroup" aria-label="Scenery">
  <button class="mode__opt" type="button" role="radio" aria-checked="true" tabindex="0" data-mode="auto" title="Auto — follows your time of day">
    <svg class="icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="8" cy="8" r="6" />
      <path d="M8 2a6 6 0 0 1 0 12z" fill="currentColor" stroke="none" />
    </svg>
    <span class="sr">Auto</span>
  </button>
  <button class="mode__opt" type="button" role="radio" aria-checked="false" tabindex="-1" data-mode="day" title="Day scenery">
    <svg class="icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="8" cy="8" r="3" />
      <path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M12.6 3.4l-1 1M4.4 11.6l-1 1" />
    </svg>
    <span class="sr">Day</span>
  </button>
  <button class="mode__opt" type="button" role="radio" aria-checked="false" tabindex="-1" data-mode="night" title="Night scenery">
    <svg class="icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M13.5 9.5A5.5 5.5 0 1 1 6.5 2.5a4.5 4.5 0 0 0 7 7z" />
    </svg>
    <span class="sr">Night</span>
  </button>
  <button class="mode__opt" type="button" role="radio" aria-checked="false" tabindex="-1" data-mode="off" title="Scenery off">
    <svg class="icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="3" width="12" height="10" rx="2" />
      <path d="M3.5 12.5l9-9" />
    </svg>
    <span class="sr">Off</span>
  </button>
</div>
