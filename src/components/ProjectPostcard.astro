---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
  total: number;
}
const { project, index, total } = Astro.props;
const d = project.data;
const slug = project.id;
const kindLabels: Record<string, string> = {
  product: "Product",
  "open-source": "Open source",
  fork: "Fork",
  work: "Client work",
  experiment: "Experiment",
};
const nn = String(index + 1).padStart(2, "0");
const tt = String(total).padStart(2, "0");
---
<article class:list={["postcard", "glass", !d.shot && "postcard--text"]} style={`view-transition-name: project-${slug}`} aria-labelledby={`p-${slug}`}>
  {d.shot && (
    <figure class="postcard__media">
      <Image class="shot" src={d.shot} alt={d.shotAlt ?? ""} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 34rem, 92vw" />
    </figure>
  )}
  <div class="postcard__body">
    <p class="eyebrow">{nn} / {tt} · {kindLabels[d.kind]} · {d.year}{d.status && <span class="eyebrow__status">{d.status}</span>}</p>
    <h3 class="postcard__title" id={`p-${slug}`}><a href={`/projects/${slug}`}>{d.title}</a></h3>
    <p class="postcard__tagline">{d.tagline}</p>
    <ul class="chips" aria-label="Built with">{d.stack.map((s) => <li class="chip">{s}</li>)}</ul>
    <div class="actions actions--small">
      <a class="btn btn--solid btn--small" href={`/projects/${slug}`}>Read the story</a>
      {d.links.repo && <a class="btn btn--small" href={d.links.repo} rel="noopener">GitHub <span aria-hidden="true">↗</span></a>}
      {d.links.live && <a class="btn btn--small" href={d.links.live} rel="noopener">Visit <span aria-hidden="true">↗</span></a>}
      {d.links.download && <a class="btn btn--small" href={d.links.download} rel="noopener">Download <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
</article>
