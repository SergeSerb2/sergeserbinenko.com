---
import { site } from "../data/site.ts";
import { scenes, photoSrc } from "../data/scenes.ts";
import type { SceneId } from "../data/scenes.ts";
import { formatTimeInZone } from "../scripts/time.ts";

export interface Thread {
  id: string;
  title: string;
  href: string;
  scene: SceneId;
  group: "Pinned" | "Projects";
  meta?: string;
  q: string;
}

interface Props {
  threads: Thread[];
  current: string;
}
const { threads, current } = Astro.props;
const groups: Array<"Pinned" | "Projects"> = ["Pinned", "Projects"];
const now = formatTimeInZone(new Date(), site.timeZone);
---
<aside class="sidebar" aria-label="Threads" transition:persist>
  <div class="side-top">
    <div class="lights">
      <button class="light r" type="button" data-action="peek" aria-label="Hide window and show the scenery" title="Show the scenery"><svg viewBox="0 0 8 8" fill="none" stroke="#4d0000" stroke-width="1.2" stroke-linecap="round"><path d="M2 2l4 4M6 2L2 6"/></svg></button>
      <button class="light y" type="button" data-action="peek" aria-label="Show the scenery" title="Show the scenery"><svg viewBox="0 0 8 8" fill="none" stroke="#5a3a00" stroke-width="1.2" stroke-linecap="round"><path d="M1.6 4h4.8"/></svg></button>
      <button class="light g" type="button" data-action="next" aria-label="Next thread" title="Next thread"><svg viewBox="0 0 8 8" fill="none" stroke="#003d00" stroke-width="1.2" stroke-linecap="round"><path d="M4 1.6v4.8M1.6 4h4.8"/></svg></button>
    </div>
  </div>
  <label class="search">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="7" cy="7" r="4.6"/><path d="M10.5 10.5L14 14"/></svg>
    <input id="search" type="search" placeholder="Search" autocomplete="off" aria-label="Search threads">
    <kbd>&#8984;K</kbd>
  </label>
  <nav class="nav" id="nav">
    <span class="nav-plate nav-plate--hover" aria-hidden="true"></span>
    <span class="nav-plate nav-plate--active" aria-hidden="true"></span>
    {groups.map((g) => (
      <div class="group">
        <div class="group-label">{g}</div>
        {threads.filter((t) => t.group === g).map((t) => (
          <a class="row" style={`--i:${threads.indexOf(t)}`} href={t.href} data-thread={t.id} data-scene={t.scene} data-q={t.q} aria-current={current === t.id ? "page" : undefined} data-astro-prefetch>
            <span class="thumb" style={`background-image:url('${photoSrc(scenes[t.scene], 64, 64)}')`}></span>
            <span class="t">{t.title}</span>
            {t.id === "contact" ? <span class="meta clock">{now}</span> : t.meta ? <span class="meta">{t.meta}</span> : null}
          </a>
        ))}
      </div>
    ))}
    <div class="group">
      <div class="group-label">Elsewhere</div>
      <a class="row ext" style={`--i:${threads.length}`} href={site.github} target="_blank" rel="noopener" data-q="github code repos"><span class="glyph"><svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></span><span class="t">GitHub</span><span class="meta">&#8599;</span></a>
      <a class="row ext" style={`--i:${threads.length + 1}`} href={`mailto:${site.email}`} data-q="email mail hello"><span class="glyph"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"><rect x="1.75" y="3.25" width="12.5" height="9.5" rx="2"/><path d="M2.4 4.4L8 8.6l5.6-4.2" stroke-linecap="round"/></svg></span><span class="t">Email</span><span class="meta">&#8599;</span></a>
    </div>
    <div class="empty" id="empty" hidden>No threads match.</div>
  </nav>
  <div class="me">
    <img src="/favicon.svg" alt="">
    <div><b>{site.name}</b><span>Vancouver &middot; <span class="clock" style="display:inline;margin:0">{now}</span></span></div>
  </div>
</aside>
