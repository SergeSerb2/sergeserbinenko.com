---
import { scenes, nightScenes, photoSrc, photoSrcset } from "../data/scenes.ts";
import type { SceneId } from "../data/scenes.ts";

interface Props {
  scenes: SceneId[];
}
const { scenes: pageScenes } = Astro.props;
const first = scenes[pageScenes[0]];
---
<div class="scenery" aria-hidden="true">
  {pageScenes.map((id, i) => {
    const scene = scenes[id];
    const nightId = nightScenes[id];
    const night = nightId ? scenes[nightId] : undefined;
    return (
      <div
        class="scene"
        data-stop-index={i}
        data-scene={id}
        data-accent={scene.accent}
        data-has-night={night ? true : undefined}
        style={`--tl: --stop-${i}; --wash-day: ${scene.color}${night ? `; --wash-night: ${night.color}` : ""}`}
      >
        <img
          class="scene__img"
          data-variant="day"
          alt=""
          decoding="async"
          sizes="100vw"
          data-srcset={photoSrcset(scene)}
          data-src={photoSrc(scene, 2400)}
          style={`--focal: ${scene.focal}`}
        />
        {night && (
          <img
            class="scene__img"
            data-variant="night"
            data-accent={night.accent}
            alt=""
            decoding="async"
            sizes="100vw"
            data-srcset={photoSrcset(night)}
            data-src={photoSrc(night, 2400)}
            style={`--focal: ${night.focal}`}
          />
        )}
      </div>
    );
  })}
  <noscript>
    <div class="scene is-active"><img class="scene__img is-loaded" src={photoSrc(first, 2400)} alt="" style={`--focal: ${first.focal}`} /></div>
  </noscript>
  <div class="scenery__light"></div>
  <div class="scenery__scrim"></div>
</div>
<script is:inline>
  try {
    var root = document.documentElement;
    if (root.dataset.scenery !== "off") {
      var sceneEl = document.querySelector(".scene");
      if (sceneEl) {
        var wantNight = root.dataset.daylight === "night";
        var img = (wantNight && sceneEl.querySelector('.scene__img[data-variant="night"]')) || sceneEl.querySelector('.scene__img[data-variant="day"]');
        if (img) {
          img.setAttribute("sizes", "100vw");
          if (img.dataset.srcset) img.setAttribute("srcset", img.dataset.srcset);
          if (img.dataset.src) img.setAttribute("src", img.dataset.src);
          img.setAttribute("fetchpriority", "high");
          sceneEl.classList.add("is-active");
          var accent = img.dataset.accent || sceneEl.dataset.accent;
          if (accent) root.style.setProperty("--accent", accent);
          var mark = function () { img.classList.add("is-loaded"); };
          if (img.complete && img.getAttribute("src")) mark();
          else img.addEventListener("load", mark, { once: true });
        }
      }
    }
  } catch (e) {}
</script>
