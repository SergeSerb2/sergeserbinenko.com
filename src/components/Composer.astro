---
interface Chip {
  label: string;
  href: string;
  external?: boolean;
}
interface Props {
  placeholder: string;
  label: string;
  subject: string;
  chips: Chip[];
}
const { placeholder, label, subject, chips } = Astro.props;
---
<form class="composer" data-composer data-subject={subject}>
  <textarea rows="2" placeholder={placeholder} aria-label={label} data-ask></textarea>
  <div class="composer-row">
    {chips.map((chip) => (
      <a class="chip" href={chip.href} {...(chip.external ? { target: "_blank", rel: "noopener" } : {})}>{chip.label}{chip.external && <> &#8599;</>}</a>
    ))}
    <button type="submit" class="send" aria-label="Send as an email"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 11.5v-9M3 6l4-3.8L11 6"/></svg></button>
  </div>
</form>
