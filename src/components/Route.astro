---
import { getCollection } from "astro:content";

interface Props {
  variant: "home" | "site";
  current?: string;
}
const { variant, current } = Astro.props;

const allNotes = await getCollection("notes").catch(() => []);
const hasNotes = allNotes.some((n) => !n.data.draft);

interface Stop {
  id: string;
  label: string;
  href: string;
}

const homeStops: Stop[] = [
  { id: "home", label: "Home", href: "#home" },
  { id: "now", label: "Now", href: "#now" },
  { id: "work", label: "Work", href: "#work" },
  { id: "resume", label: "Résumé", href: "#resume" },
  ...(hasNotes ? [{ id: "notes", label: "Notes", href: "#notes" }] : []),
  { id: "contact", label: "Contact", href: "#contact" },
];

const siteStops: Stop[] = [
  { id: "home", label: "Home", href: "/" },
  { id: "work", label: "Work", href: "/projects" },
  { id: "resume", label: "Résumé", href: "/resume" },
  ...(hasNotes ? [{ id: "notes", label: "Notes", href: "/notes" }] : []),
  { id: "contact", label: "Contact", href: "/#contact" },
];

const stops = variant === "home" ? homeStops : siteStops;
---
<nav class="route glass" aria-label="Sections">
  <ol class="route__list">
    {stops.map((stop) => (
      <li>
        <a
          class="route__stop"
          href={stop.href}
          data-stop={stop.id}
          aria-current={variant === "site" && current === stop.id ? "page" : undefined}
        ><span class="route__dot" aria-hidden="true"></span><span class="route__label">{stop.label}</span></a>
      </li>
    ))}
  </ol>
</nav>
