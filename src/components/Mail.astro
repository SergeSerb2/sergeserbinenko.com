---
import { site } from "../data/site.ts";
import { scenes, photoSrc } from "../data/scenes.ts";

interface Props {
  number: string;
}
const { number } = Astro.props;
const stampScene = scenes["tofino-dusk"];
const githubLabel = site.github.replace(/^https?:\/\//, "");
---
<div class="mail glass" data-tilt>
  <div class="mail__message">
    <p class="eyebrow">{number} — Contact</p>
    <h2 class="title" id="contact-title">Send a postcard.</h2>
    <p class="mail__note">Tell me what you are building, or just say hello.</p>
    <div class="actions">
      <a class="btn btn--solid" href={`mailto:${site.email}`}>Write to me</a>
      <button class="btn" type="button" data-copy={site.email}>Copy email</button>
    </div>
  </div>
  <div class="mail__address">
    <div class="mail__stamps" aria-hidden="true">
      <span class="stamp"><img src={photoSrc(stampScene, 320)} alt="" loading="lazy" /></span>
      <span class="postmark"><span class="postmark__text">Vancouver</span><span class="postmark__date" data-today></span></span>
    </div>
    <ul class="mail__lines">
      <li><span class="mail__key">To</span><span>Serge Serbinenko</span></li>
      <li><span class="mail__key">Email</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><span class="mail__key">GitHub</span><a href={site.github} rel="noopener">{githubLabel}</a></li>
      {site.linkedin && <li><span class="mail__key">LinkedIn</span><a href={site.linkedin} rel="noopener">{site.linkedin.replace(/^https?:\/\//, "")}</a></li>}
      <li><span class="mail__key">Based in</span><span>{site.location}</span></li>
    </ul>
  </div>
</div>
