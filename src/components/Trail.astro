---
import { experience } from "../data/resume.ts";

function publicSummary(summary: string): string | null {
  return summary.startsWith("TODO(serge)") ? null : summary;
}
---
<ol class="trail">
  {experience.map((role) => {
    const summary = publicSummary(role.summary);
    return (
      <li class="trail__stop">
        <p class="trail__when">{role.start} — {role.end}</p>
        <div class="trail__what">
          <h3 class="trail__role">{role.title}</h3>
          <p class="trail__org">{role.org}</p>
          {summary && <p class="trail__note">{summary}</p>}
        </div>
      </li>
    );
  })}
</ol>
