---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import type { SceneId } from "../../data/scenes.ts";

export async function getStaticPaths() {
  const all = await getCollection("notes").catch(() => []);
  return all
    .filter((n) => !n.data.draft)
    .map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const dateFmt = new Intl.DateTimeFormat("en-CA", { year: "numeric", month: "long", day: "numeric" });
---
<Base title={note.data.title} description={note.data.description} scenes={[note.data.scene as SceneId]} route="site" current="notes">
  <div class="page" data-scene={note.data.scene} data-stop="notes">
    <article class="sheet glass prose">
      <header class="note__head">
        <p class="eyebrow"><time datetime={note.data.date.toISOString()}>{dateFmt.format(note.data.date)}</time></p>
        <h1 class="title">{note.data.title}</h1>
        <p class="lead">{note.data.description}</p>
      </header>
      <Content />
    </article>
    <nav class="page__nav" aria-label="Notes"><a class="link-back" href="/notes">All notes</a></nav>
  </div>
</Base>
