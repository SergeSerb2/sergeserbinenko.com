---
import App from "../layouts/App.astro";
import { site } from "../data/site.ts";
import { experience, education } from "../data/resume.ts";

function when(start: string, end: string): string {
  return start === end ? start : `${start} — ${end}`;
}
---
<App title="Résumé" thread="resume" scene="moraine" crumb="Résumé">
  <div class="resume">
    <header class="print-only print-head">
      <b>{site.name}</b> &middot; {site.role} &middot; {site.location}<br>
      {site.email} &middot; sergeserbinenko.com &middot; {site.github.replace("https://", "")}
    </header>
    <p class="kicker"><i></i>Vancouver, BC &middot; {site.languages.join(", ")}</p>
    <h1 class="title">Résumé</h1>
    <p class="intro">By day I am a machine learning engineer at PressReader, the platform behind thousands of newspapers and magazines worldwide. The rest of the time I build the tools I want to use, mostly in TypeScript, Swift, and Rust, with coding agents doing a lot of the typing.</p>
    <div class="actions no-print">
      <button class="btn ghost" type="button" data-print>Save as PDF</button>
    </div>
    <ol class="xp">
      {experience.map((x) => (
        <li><b>{x.title}</b><span>{x.org}</span><time>{when(x.start, x.end)}</time></li>
      ))}
    </ol>
    <h2 class="subhead">Education</h2>
    <ol class="xp" style="margin-top:8px">
      {education.map((ed) => (
        <li><b>{ed.degree}</b><span>{ed.school}</span><time>{when(ed.start, ed.end)}</time></li>
      ))}
    </ol>
  </div>
</App>
