---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" scenes={["faroe"]} route="site">
  <div class="page page--center" data-scene="faroe" data-stop="home">
    <div class="card glass">
      <p class="eyebrow">404</p>
      <h1 class="title" id="not-found-title">You’ve wandered off the map.</h1>
      <p class="lead">This page doesn’t exist, but the view is nice.</p>
      <div class="actions"><a class="btn btn--solid" href="/">Back to the start</a></div>
    </div>
  </div>
</Base>
