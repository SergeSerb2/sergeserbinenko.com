---
import App from "../layouts/App.astro";
import Composer from "../components/Composer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CardCredits from "../components/CardCredits.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const recent = projects.slice(0, 3);
---
<App title="Serge Serbinenko" thread="about" scene="tofino" crumb="About">
  <div class="about">
    <h1 class="hello">Hi, I&#8217;m Serge.</h1>
    <p class="lead">Machine learning engineer in Vancouver. I build AI tools and native apps, and I like software that is calm, fast, and good to look at.</p>
    {/* Inline display:none because `.chat { display: flex }` in app.css beats [hidden]. */}
    <section class="chat" aria-label="Conversation with the site agent" hidden style="display: none">
      <div class="chat__head"><span>Site agent · answers questions about Serge</span><button class="chat__reset" type="button">New chat</button></div>
      <ol class="chat__log"></ol>
    </section>
    <Composer
      agent
      placeholder="Ask me anything about my work"
      label="Ask about my work"
      subject="A question about your work"
      chips={[
        { label: "Projects", href: "/projects" },
        { label: "Résumé", href: "/resume" },
        { label: "Say hello", href: "/contact" },
      ]}
    />
    <p class="chat__note" hidden></p>
    <section class="recent">
      <h2 class="section-label"><span>Recent threads</span><a href="/projects">All {projects.length} projects</a></h2>
      <div class="cards">{recent.map((p) => <ProjectCard project={p} />)}</div>
      <CardCredits projects={recent} />
    </section>
  </div>
</App>
