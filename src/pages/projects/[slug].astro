---
import App from "../../layouts/App.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { scenes, photoSrc } from "../../data/scenes.ts";
import type { SceneId } from "../../data/scenes.ts";
import { site } from "../../data/site.ts";

export async function getStaticPaths() {
  const all = await getCollection("projects");
  const projects = all.filter((p) => !p.data.draft).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const d = project.data;
const scene = scenes[d.scene as SceneId];
const { Content } = await render(project);

const kindLabels: Record<string, string> = {
  product: "Product",
  "open-source": "Open source",
  fork: "Fork",
  work: "Client work",
  experiment: "Experiment",
};
const kicker = [kindLabels[d.kind], d.year, d.status].filter(Boolean).join(" · ");
---
<App title={d.title} description={d.tagline} thread={project.id} scene={d.scene as SceneId} crumb={d.title}>
  <article class="project-wrap">
    <div class:list={["project", { "no-shot": !d.shot }]}>
      <div>
        <p class="kicker"><i></i>{kicker}</p>
        <h1 class="title">{d.title}</h1>
        <p class="tagline">{d.tagline}</p>
        <ul class="stack">{d.stack.map((x) => <li>{x}</li>)}</ul>
        {!d.shot && (
          <dl class="facts">
            <dt>Kind</dt><dd>{kindLabels[d.kind]}</dd>
            <dt>Year</dt><dd>{d.year}</dd>
            {d.status && <><dt>Status</dt><dd>{d.status}</dd></>}
            <dt>Place</dt><dd>{scene.place}</dd>
          </dl>
        )}
        <div class="actions">
          {d.links.repo
            ? <a class="btn" href={d.links.repo} target="_blank" rel="noopener">Open on GitHub <span aria-hidden="true">&#8599;</span></a>
            : <a class="btn ghost" href={`mailto:${site.email}?subject=${encodeURIComponent(d.title)}`}>Ask about {d.title}</a>}
          {d.links.live && <a class="btn ghost" href={d.links.live} target="_blank" rel="noopener">Visit <span aria-hidden="true">&#8599;</span></a>}
          {d.links.download && <a class="btn ghost" href={d.links.download} target="_blank" rel="noopener">Download <span aria-hidden="true">&#8599;</span></a>}
        </div>
      </div>
      {d.shot ? (
        <figure class="shot"><Image src={d.shot} alt={d.shotAlt ?? ""} widths={[640, 960, 1280]} sizes="(min-width: 701px) 480px, 92vw" /></figure>
      ) : (
        <figure class="shot place" style={`background-image:url('${photoSrc(scene, 760, 950)}');background-position:${scene.focal}`}>
          <figcaption>{scene.place}<small>{scene.coords}</small></figcaption>
        </figure>
      )}
    </div>
    <div class="prose project-story">
      <Content />
    </div>
  </article>
</App>
