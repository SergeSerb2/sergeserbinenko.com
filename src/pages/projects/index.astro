---
import App from "../../layouts/App.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CardCredits from "../../components/CardCredits.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---
<App title="Projects" thread="projects" scene="skye" crumb="All projects">
  <div class="projects">
    <h1 class="title">All projects</h1>
    <p class="lead">Things I built, forked, and reshaped.</p>
    <div class="cards projects-grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
    <CardCredits projects={projects} />
  </div>
</App>
